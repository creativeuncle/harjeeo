NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/harjeeo
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
# Outgoing email via SMTP. Works with Brevo, Resend, Gmail, or any SMTP
# provider — just point these at your provider's SMTP relay credentials.
# Example (Brevo): host smtp-relay.brevo.com, port 587, user is your Brevo
# account login email, pass is the SMTP key from Brevo's SMTP & API settings.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login
SMTP_PASS=your_smtp_key
EMAIL_FROM=Harjeeo <no-reply@yourdomain.com>

# Web push (VAPID). Dev keypair below works out of the box; generate your own
# for production with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=BHz4A7XKQFdEioCYUfQQRU-cpuT0IEg7qrDhtcBD9JrNHYJYil1pdGb5oDzdDiPkuOtxZajRclNNGmCRSk1Ab5w
VAPID_PRIVATE_KEY=4piBIBaLeFrHE0c1-z0WWq78GL_OGg61E1JQ3Z3X6_E
VAPID_SUBJECT=mailto:support@harjeeo.app

# Google Sign-In. Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials, add your frontend
# origin(s) to "Authorized JavaScript origins", and use the same client ID
# here and in frontend/.env as VITE_GOOGLE_CLIENT_ID. GOOGLE_CLIENT_SECRET
# comes from the same client (needed to exchange the auth code it sends us).
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
